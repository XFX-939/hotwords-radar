{
  "name": "hotwords-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-with-wasm.mjs dev",
    "build": "node scripts/next-with-wasm.mjs build",
    "start": "node scripts/next-with-wasm.mjs start",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/create-sqlite-db.mjs && prisma migrate deploy",
    "db:push": "node scripts/create-sqlite-db.mjs && prisma db push",
    "db:seed": "tsc -p tsconfig.scripts.json && node .script-dist/prisma/seed.js",
    "refresh": "tsc -p tsconfig.scripts.json && node .script-dist/scripts/refresh.js",
    "cron": "tsc -p tsconfig.scripts.json && node .script-dist/scripts/cron.js"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "clsx": "^2.1.1",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "echarts-wordcloud": "^2.1.0",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "next-themes": "^0.4.6",
    "node-cron": "^3.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^15.5.18",
    "@types/node": "^22.15.17",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.2",
    "postcss": "^8.4.49",
    "prisma": "^6.8.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsc -p tsconfig.scripts.json && node .script-dist/prisma/seed.js"
  }
}
